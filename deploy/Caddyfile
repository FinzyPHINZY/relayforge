# caddy ignores any client-supplied X-Forwarded-For (no trusted_proxies is configured)
# and sets it to the connecting client IP, which the dashboard uses for sign-in rate
# limits. this needs caddy 2.5 or newer (the compose files pin caddy:2.10-alpine); do not
# add trusted_proxies unless another proxy sits in front of caddy.
#
# X-RelayForge-* headers are set only by the dashboard server on its internal calls;
# strip any client-supplied copies at the edge.
# access logging is not enabled; if you add it, filter the `token` query parameter so
# emailed sign-in links are not recorded.

{$RELAYFORGE_DASHBOARD_DOMAIN} {
    encode zstd gzip
    reverse_proxy dashboard:3000 {
        header_up -X-RelayForge-Dashboard-Token
        header_up -X-RelayForge-Client-IP
    }
}

{$RELAYFORGE_API_DOMAIN} {
    encode zstd gzip
    reverse_proxy api:8080 {
        header_up -X-RelayForge-Dashboard-Token
        header_up -X-RelayForge-Client-IP
    }
}
