DATABASE_URL=postgres://webhooks:webhooks@localhost:5432/webhooks?sslmode=disable
ENCRYPTION_KEY_BASE64=REPLACE_WITH_BASE64_OF_32_RANDOM_BYTES
ENCRYPTION_KEY_ID=local-v1
LISTEN_ADDR=:8080
WORKER_CONCURRENCY=10
ENDPOINT_CONCURRENCY_LIMIT=2
TENANT_CONCURRENCY_LIMIT=10
WORKER_DRAIN_SECONDS=35
EVENT_RATE_LIMIT_PER_MINUTE=600
MANAGEMENT_RATE_LIMIT_PER_MINUTE=120
# REDIS_URL is optional for a standalone API; Compose connects the API to its Redis service.
RETENTION_DAYS=30
DEMO_RECEIVER_ORIGIN=
DASHBOARD_SESSION_KEY=
