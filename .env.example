DATABASE_URL=postgres://webhooks:webhooks@localhost:5432/webhooks?sslmode=disable
ENCRYPTION_KEY_BASE64=REPLACE_WITH_BASE64_OF_32_RANDOM_BYTES
ENCRYPTION_KEY_ID=local-v1
LISTEN_ADDR=:8080
WORKER_CONCURRENCY=10
ENDPOINT_CONCURRENCY_LIMIT=100
TENANT_CONCURRENCY_LIMIT=10
WORKER_DRAIN_SECONDS=35
EVENT_RATE_LIMIT_PER_MINUTE=600
MANAGEMENT_RATE_LIMIT_PER_MINUTE=120
# REDIS_URL is optional for a standalone API; Compose connects the API to its Redis service.
RETENTION_DAYS=30
REGION_ROLE=primary
DEMO_RECEIVER_ORIGIN=
# Dashboard cookie encryption key: base64 of 32 random bytes (openssl rand -base64 32).
DASHBOARD_SESSION_KEY=
# Set to false only for local http:// development.
DASHBOARD_SECURE_COOKIES=true
# API base URL the dashboard server calls (internal address in Compose).
RELAYFORGE_API_URL=http://127.0.0.1:8080

# --- Console sign-in (GitHub + email magic link) ---------------------------------
# Sign-in is enabled only when DASHBOARD_PUBLIC_URL, DASHBOARD_API_TOKEN and
# IP_HASH_KEY_BASE64 are all set. Leave them empty to keep API-key login only.
# Public origin of the dashboard, used in emailed links, the GitHub callback and
# same-origin checks. Set it on BOTH the API and the dashboard.
DASHBOARD_PUBLIC_URL=http://localhost:3000
# Shared secret the dashboard sends on /v1/auth calls (>= 32 chars; same value on
# the API and the dashboard). Generate with: openssl rand -base64 32
DASHBOARD_API_TOKEN=
# HMAC key for hashing client IPs (rate limits, sessions): base64 of 32 random bytes.
IP_HASH_KEY_BASE64=

# Email delivery: "log" (default, prints to the API log) or "ses" (Amazon SES).
MAIL_PROVIDER=log
# Sender address; required for ses. Must be at a verified SES domain.
MAIL_FROM=RelayForge <sign-in@relayforge.site>
# Required to be eu-north-1 when MAIL_PROVIDER=ses.
AWS_REGION=eu-north-1
# Local development only: log full email bodies (including sign-in links). Never in production.
MAIL_LOG_BODIES=false

# GitHub OAuth App (Settings > Developer settings > OAuth Apps). Set both or neither.
# Callback URL: <DASHBOARD_PUBLIC_URL>/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Abuse limits (defaults shown).
MAGIC_LINK_PER_EMAIL_PER_HOUR=5
MAGIC_LINK_PER_IP_PER_HOUR=20
OAUTH_START_PER_IP_PER_HOUR=30
MAX_WORKSPACES_PER_USER=3
# Optional production monitoring profile. Set a private HTTPS notification webhook URL.
MONITOR_WEBHOOK_URL=
MONITOR_BACKLOG_AGE_SECONDS=300
MONITOR_INTERVAL_SECONDS=60
MONITOR_FAILURE_THRESHOLD=5
MONITOR_UNREVIEWED_THRESHOLD=1
# Optional OTLP/HTTP collector for traces and metrics.
OTEL_EXPORTER_OTLP_ENDPOINT=
